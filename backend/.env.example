# Copy to backend/.env and fill in. .env is gitignored — never commit real values.

# --- Runtime ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------
# Hosted Postgres with pgvector (Neon or Supabase). Paste the connection
# string exactly as the provider gives it — the app rewrites the scheme to
# asyncpg and moves sslmode into the TLS context automatically.
#   Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   Supabase: postgresql://postgres:pass@db-xxx.supabase.co:5432/postgres
# Enable the extension once from the provider's SQL console:
#   CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=
DB_ECHO=false

# --- Auth ---------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_LIFETIME_SECONDS=86400

# --- Gemini Live (voice) ------------------------------------------------
# https://aistudio.google.com/apikey
# Server-side only. The browser gets an ephemeral token, never this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-live-preview

# --- Payments (Razorpay) ------------------------------------------------
# https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use TEST keys (rzp_test_...) until you are ready to take real money.
#
# KEY_ID is publishable — Razorpay's checkout widget needs it in the browser.
# KEY_SECRET signs and verifies payments: anyone holding it can forge a
# successful purchase, so it stays on this server only.
#
# Leave both blank and the app still runs: free courses enrol as normal, paid
# ones report that checkout is unavailable instead of failing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set when you add the webhook in the Razorpay dashboard. A DIFFERENT value
# from KEY_SECRET; without it, webhooks are refused rather than trusted.
RAZORPAY_WEBHOOK_SECRET=

# --- Business rules -----------------------------------------------------
# Certification exams only. Quizzes are unlimited; content reading is unlimited.
CERT_DEFAULT_MAX_ATTEMPTS=3

# What a tutoring session must do before it completes a module. Both apply.
MODULE_COMPLETE_MIN_SECONDS=60
MODULE_COMPLETE_MIN_TURNS=1

# --- CORS ---------------------------------------------------------------
# Comma-separated. Add the Vercel URL when the frontend is deployed.
CORS_ORIGINS=http://localhost:3000
